{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/beep"
          }
        ]
      }
    ]
  },
  "ask": [
    "Bash(find * -exec *)",
    "Bash(find * -execdir *)",

    "Bash(true)"
  ],
  "permissions": {
    "additionalDirectories": ["~/go/pkg/mod"],
    "allow": [
      "Bash(cat *)",
      "Bash(dir *)",
      "Bash(du *)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(git add *)",
      "Bash(git blame *)",
      "Bash(git branch *)",
      "Bash(git cat-file *)",
      "Bash(git check-ignore *)",
      "Bash(git commit *)",
      "Bash(git config --local --get *)",
      "Bash(git describe *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git ls-files *)",
      "Bash(git ls-remote *)",
      "Bash(git ls-tree *)",
      "Bash(git merge *)",
      "Bash(git remote -v *)",
      "Bash(git rev-list *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git submodule status *)",
      "Bash(git submodule summary *)",
      "Bash(git switch *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(nl -ba *)",
      "Bash(printf *)",
      "Bash(pwd *)",
      "Bash(sed --posix -n *)",
      "Bash(sed -E -n *)",
      "Bash(sed -n *)",
      "Bash(sed -r -n *)",
      "Bash(sed-safe *)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(touch *)",
      "Bash(tree *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(where *)",
      "Bash(which *)",

      "Bash(true)"
    ]
  },
  "tui": "fullscreen",
  "theme": "light",
  "agentPushNotifEnabled": true
}
