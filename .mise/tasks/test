. ./.lib/utils.sh
shift 2
cd "$1" || exit 1; shift

test_47fd512() {
  push_dir "$INITIAL_DIR"/.lib-test || exit 1
  ./run-tests "$@"
  pop_dir || exit 1
}

_() { test "${0##*/}" = "$1" -o "${0##*\\}" = "$1" -o "${0##*/}" = "$1.sh" -o "${0##*\\}" = "$1.sh"; }; if _ test
then
  set -o nounset -o errexit
  test_47fd512 "$@"
fi
