#!/usr/bin/env sh
# vim: set filetype=sh tabstop=2 shiftwidth=2 expandtab :
# shellcheck shell=sh

test "${_APPDIR+set}" = set || { cd "${0%[/\\]*}" 2>/dev/null || cd .; _APPDIR="$PWD"; cd "$OLDPWD" || exit; }

resolve_file() {
  test "${file+set}" = set || return 1
  local cand
  for cand in \
    "$_APPDIR"/"$file" \
    "$_APPDIR"/mise/"$file" \
    "$_APPDIR"/.mise/"$file" \
    "$_APPDIR"/.config/"$file" \
    "$_APPDIR"/.config/mise/"$file" \
    "$_APPDIR"/.config/mise/conf.d/"$file"
  do
    test -r "$cand" && file="$cand" && break
  done
}

task() {
  local mise_env=
  OPTIND=1; while getopts _-:E: OPT
  do
    test "$OPT" = - && OPT="${OPTARG%%=*}" && OPTARG="${OPTARG#"$OPT"=}"
    case "$OPT" in
      (E|env) mise_env="$OPTARG";;
      (?) exit 1;;
      (*) echo "$0: illegal option -- $OPT" >&2; exit 1;;
    esac
  done
  shift $((OPTIND-1))

  test $# = 0 && exec "$_APPDIR"/mise tasks
  test -n "$mise_env" && export MISE_ENV="$mise_env"
  case "$1" in
    (*.sh:*|*.bash:*)
      # "file_name:function_name"
      local file_func="$1"
      shift
      local file
      file="${file_func%:*}"
      case "$file" in
        (*/*) ;;
        (*) test -r "$file" || resolve_file;;
      esac
      local dir
      dir="$(dirname "$file")"
      local func
      func="${file_func##*:}"
      case "$file" in
        (*.bash)
          bash -c "source \"$file\"; \"$func\""
          ;;
        (*)
          set -- _LIBDIR "$dir" "$@"
          # shellcheck disable=SC1090
          . ./"$file"
          shift 2
          "$func" "$@"
          ;;
      esac
      ;;
    (*/*.sh|*/*.bash)
      # "file_name"
      local file="$1"
      case "$file" in
        (*/*) ;;
        (*) test -r "$file" || resolve_file;;
      esac
      case "$file" in
        (*.bash)
          bash "$@"
          ;;
        (*)
          sh "$@"
          ;;
      esac
      ;;
    (*)
      set -- run "$@"
      if test -n "$mise_env"
      then
        set -- --env "$mise_env" "$@"
      fi
      exec "$_APPDIR"/mise "$@"
      ;;
  esac
}

_() { case "${0##*[/\\]}" in ("$1"|"$1".*) :;; (*) ! :;; esac; }; if _ task
then
  set -o nounset -o errexit
  task "$@"
fi
